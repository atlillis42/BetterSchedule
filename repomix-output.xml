import { useEffect, useState } from "react";
import {
    DayPilot,
    DayPilotCalendar,
    DayPilotMonth,
    DayPilotNavigator,
    DayPilotScheduler
} from "@daypilot/daypilot-lite-react";

import { getResources } from "@/api/calendar-resource-api";
import { getBlockedTimes } from "@/api/blockedtime-api";
import { getReservations } from "@/api/reservation-api";
import type { CalendarResource, UiEvent } from "@/types/calendarDataTypes";

import { formatWeekHeader } from "@/utilities/calendarDisplay/formatWeekHeader";
import { getVisibleRange } from "@/utilities/calendarDisplay/getVisibleRange";
import { getLocalDateString, getLocalTimeString, combineDateTime } from "@/utilities/conversions/dateParsing";
import { eventModalFields } from "@/utilities/formFields/eventModalFields";
import { buildEventApiDto } from "@/utilities/mapping/buildEventApiDto";
import { extractEventFields } from "@/utilities/legacy/extractEventFields";
import { blockedTimeToUiEvent } from "@/utilities/mapping/blockedTimeToUiEvent";
import { reservationToUiEvent } from "@/utilities/mapping/reservationToUiEvent";
import { toDayPilotEvents } from "@/utilities/calendarDisplay"; 

import "@styles/Calendar.css";
import type { CalendarTimeRangeSelectedArgs } from "@/types/daypilotTypes";

/**
 * Combines BlockedTimes and Reservations into a single UiEvent[] for DayPilot.
 */
async function fetchAllEvents(
    startDate: DayPilot.Date,
    endDate: DayPilot.Date
): Promise<UiEvent[]> {
    const [blockedTimes, reservations] = await Promise.all([
        getBlockedTimes({ start: startDate.toString("yyyy-MM-dd"), end: endDate.toString("yyyy-MM-dd") }),
        getReservations({ start: startDate.toString("yyyy-MM-dd"), end: endDate.toString("yyyy-MM-dd") })
    ]);
    const blockedEvents = blockedTimes.map(blockedTimeToUiEvent);
    const reservationEvents = reservations.map(reservationToUiEvent);
    return [...blockedEvents, ...reservationEvents];
}

const Calendar = () => {
    const [view, setView] = useState<"Day" | "Week" | "Month" | "Resources">("Week");
    const [startDate, setStartDate] = useState(DayPilot.Date.today());
    const [events, setEvents] = useState<UiEvent[]>([]);
    const [resources, setResources] = useState<CalendarResource[]>([]);

    // Handles time range selection for creating either a reservation or a blocked time
    const onTimeRangeSelected = async (args: CalendarTimeRangeSelectedArgs) => {
        const dp = args.control;
        let formError = "";

        const startDateStr = getLocalDateString(args.start);
        const startTime = getLocalTimeString(args.start);
        const endDateStr = getLocalDateString(args.end);
        const endTime = getLocalTimeString(args.end);

        while (true) {
            const form = eventModalFields({
                resources,
                includeDelete: false,
                values: {
                    startDate: startDateStr,
                    startTime,
                    endDate: endDateStr,
                    endTime,
                    resourceId: args.resource ?? resources[0]?.id ?? "",
                    formError
                }
            });

            const modal = await DayPilot.Modal.form(form, {
                startDate: startDateStr,
                startTime,
                endDate: endDateStr,
                endTime,
                resourceId: args.resource ?? resources[0]?.id ?? "",
            });

            dp.clearSelection();
            if (modal.canceled || !modal.result || !modal.result.text) return;

            const startCheck = combineDateTime(modal.result.startDate, modal.result.startTime);
            const endCheck = combineDateTime(modal.result.endDate, modal.result.endTime);

            if (!startCheck.iso) {
                formError = startCheck.errorMsg || "Invalid start date/time.";
                continue;
            }
            if (!endCheck.iso) {
                formError = endCheck.errorMsg || "Invalid end date/time.";
                continue;
            }
            if (new Date(endCheck.iso) <= new Date(startCheck.iso)) {
                formError = "End time must be after start time.";
                continue;
            }

            // TODO: Route create action to correct API based on modal toggle (reservation/block)
            // Example:
            /*
            await createReservation({
                clientId: "TODO",
                serviceProviderId: "TODO",
                appointmentTypeId: 1,
                startTime: startCheck.iso,
                endTime: endCheck.iso,
            });
            */

            // After create, refetch events for visible window
            const { start, end } = getVisibleRange(
                new DayPilot.Date(modal.result.startDate),
                view
            );
            const allEvents = await fetchAllEvents(start, end);
            setEvents(allEvents);
            break;
        }
    };

    const onEventClick = async (args: any) => {
        const eventFields = extractEventFields(args.e);

        if (!eventFields.startDate || !eventFields.endDate) {
            alert("Event is missing start or end time and cannot be edited.");
            return;
        }

        const formError = "";

        while (true) {
            const form = eventModalFields({
                resources,
                includeDelete: true,
                values: {
                    text: eventFields.text,
                    startDate: eventFields.startDate,
                    startTime: eventFields.startTime,
                    endDate: eventFields.endDate,
                    endTime: eventFields.endTime,
                    resourceId: eventFields.resourceId ?? "",
                    formError,
                    delete: false,
                }
            });

            const modal = await DayPilot.Modal.form(form, {
                text: eventFields.text,
                startDate: eventFields.startDate,
                startTime: eventFields.startTime,
                endDate: eventFields.endDate,
                endTime: eventFields.endTime,
                resourceId: eventFields.resourceId ?? "",
                delete: false,
            });

            if (modal.canceled) return;

            // TODO: Route update/delete to correct API by event type

            break;
        }

        const { start: rangeStart, end: rangeEnd } = getVisibleRange(new DayPilot.Date(eventFields.startDate), view);
        const allEvents = await fetchAllEvents(rangeStart, rangeEnd);
        setEvents(allEvents);
    };

    useEffect(() => {
        (async () => {
            try {
                const { start, end } = getVisibleRange(startDate, view);
                const [realResources, allEvents] = await Promise.all([
                    getResources(),
                    fetchAllEvents(start, end)
                ]);
                if (realResources.length) setResources(realResources);
                setEvents(allEvents);
            } catch (err) {
                console.error("⛔ Calendar API fetch failed – falling back to demo data", err);
            }
        })();
    }, [startDate, view]);

    useEffect(() => {
        console.log("Resources:", resources);
        console.log("Events:", events);
    }, [resources, events]);

    const getNavigatorMode = () => (view === "Month" ? "Month" : "Day");

    return (
        <>
            {process.env.NODE_ENV === "test" && (
                <ul data-testid="calendar-event-titles" style={{ display: "none" }}>
                    {events.map(e => <li key={e.id}>{e.text}</li>)}
                </ul>
            )}
            <div className="calendar-container w-full h-full flex flex-row overflow-hidden">
                <div className="calendar-sidebar w-64 bg-white shadow-md border-r border-gray-200">
                    <DayPilotNavigator
                        theme="betterschedule_navigator"
                        selectMode={getNavigatorMode()}
                        showMonths={3}
                        skipMonths={3}
                        onTimeRangeSelected={(args) => setStartDate(args.day)}
                        events={events}
                    />
                </div>

                <div className="calendar-main flex flex-col flex-1 min-w-0">
                    <div className="calendar-toolbar flex gap-2 p-2 border-b bg-gray-100">
                        <button onClick={() => setView("Day")} className={view === "Day" ? "selected" : ""}>
                            Day
                        </button>
                        <button onClick={() => setView("Week")} className={view === "Week" ? "selected" : ""}>
                            Week
                        </button>
                        <button onClick={() => setView("Month")} className={view === "Month" ? "selected" : ""}>
                            Month
                        </button>
                        <button onClick={() => setView("Resources")} className={view === "Resources" ? "selected" : ""}>
                            Resources
                        </button>
                        <button onClick={() => setStartDate(DayPilot.Date.today())} className="standalone">
                            Today
                        </button>
                    </div>

                    <div className="calendar-body flex-1 overflow-auto">
                        {view === "Day" && (
                            <DayPilotCalendar
                                viewType="Day"
                                theme="betterschedule"
                                startDate={startDate}
                                events={events}
                                durationBarVisible={false}
                                onTimeRangeSelected={onTimeRangeSelected}
                                onEventClick={onEventClick}
                                headerHeight={40}
                                onBeforeHeaderRender={(args) => {
                                    const { weekday, short } = formatWeekHeader(args.header.start);
                                    args.header.html = `
                                        <div style="display:flex;flex-direction:column;align-items:center;line-height:1.2">
                                            <span style="font-weight:600">${weekday}</span>
                                            <span style="font-size:12px">${short}</span>
                                        </div>`;
                                }}
                            />
                        )}

                        {view === "Week" && (
                            <DayPilotCalendar
                                viewType="Week"
                                theme="betterschedule"
                                startDate={startDate}
                                events={events}
                                durationBarVisible={false}
                                onTimeRangeSelected={onTimeRangeSelected}
                                onEventClick={onEventClick}
                                headerHeight={40}
                                onBeforeHeaderRender={(args) => {
                                    const { weekday, short } = formatWeekHeader(args.header.start);
                                    args.header.html = `
                                        <div style="display:flex;flex-direction:column;align-items:center;line-height:1.2">
                                            <span style="font-weight:600">${weekday}</span>
                                            <span style="font-size:12px">${short}</span>
                                        </div>`;
                                }}
                            />
                        )}

                        {view === "Month" && (
                            <div className="month-wrapper">
                                <DayPilotMonth
                                    startDate={startDate}
                                    theme="monthlybetterschedule"
                                    events={events}
                                    eventBarVisible={false}
                                    onTimeRangeSelected={onTimeRangeSelected}
                                    onEventClick={onEventClick}
                                />
                            </div>
                        )}

                        {view === "Resources" && (
                            <DayPilotScheduler
                                startDate={startDate}
                                days={5}
                                scale="Hour"
                                timeHeaders={[
                                    { groupBy: "Day", format: "dddd MMM d" },
                                    { groupBy: "Hour" }
                                ]}
                                resources={resources}
                                events={events}
                                onEventClick={onEventClick}
                                cellWidth={50}
                                headerHeight={30}
                                rowHeaderWidth={150}
                                durationBarVisible={false}
                            />
                        )}
                    </div>
                </div>
            </div>
        </>
    );
};

export default Calendar;
