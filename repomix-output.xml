        [Required]
        public DateTimeOffset EndTime { get; set; }
        public int? ResourceId { get; set; }
        public string? BackColor { get; set; } = "#a3a87ad";
        public bool IsDeleted { get; set; } = false; // Soft delete

        public CalendarResource? Resource { get; set; }
    }
}
